<section id="finds" class="finds" aria-labelledby="finds-title">
  <div class="section-head">
    {% if section.settings.hand_label != blank %}
      <p class="hand-label rotate-left">{{ section.settings.hand_label }}</p>
    {% endif %}
    <h2 id="finds-title" class="display-title">{{ section.settings.heading }}</h2>
    {% if section.settings.lede != blank %}
      <p class="lede">{{ section.settings.lede }}</p>
    {% endif %}
  </div>

  <ul class="finds__grid">
    {% for block in section.blocks %}
      {% liquid
        assign clip_class = 'clip--orange'
        case block.settings.accent
          when 'teal'
            assign clip_class = 'clip--teal'
          when 'yellow'
            assign clip_class = 'clip--yellow'
          when 'lime'
            assign clip_class = 'clip--lime'
          when 'pink'
            assign clip_class = 'clip--pink'
          when 'cream'
            assign clip_class = 'clip--cream'
        endcase
        assign rotate_class = ''
        if forloop.index0 == 0 or forloop.index0 == 3
          assign rotate_class = 'rotate-right'
        elsif forloop.index0 == 1 or forloop.index0 == 4
          assign rotate_class = 'rotate-left'
        endif
      %}
      <li class="clip {{ clip_class }} {{ rotate_class }}" {{ block.shopify_attributes }}>
        {% if block.settings.badge != blank %}
          <span class="clip__price" aria-hidden="true">{{ block.settings.badge }}</span>
        {% endif %}
        <h3>{{ block.settings.title }}</h3>
        {% if block.settings.body != blank %}
          <p>{{ block.settings.body }}</p>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</section>

{% schema %}
{
  "name": "Finds categories",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "hand_label",
      "label": "Handwritten label",
      "default": "fresh from the crates"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What you’ll find"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "No fake storefront inventory here — just the categories that keep the booth humming. Plug a collection into Featured products when you’re ready to sell online."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Vintage glass"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Cut crystal, milk glass, and the weird pretty stemware nobody else grabbed."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Corner badge",
          "default": "★"
        },
        {
          "type": "select",
          "id": "accent",
          "label": "Accent",
          "options": [
            { "value": "orange", "label": "Orange" },
            { "value": "teal", "label": "Teal" },
            { "value": "yellow", "label": "Yellow" },
            { "value": "lime", "label": "Lime" },
            { "value": "pink", "label": "Pink" },
            { "value": "cream", "label": "Cream" }
          ],
          "default": "orange"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Finds categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Vintage glass",
            "body": "Cut crystal, milk glass, and the weird pretty stemware nobody else grabbed.",
            "badge": "★",
            "accent": "orange"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Decor & kitsch",
            "body": "Figurines, florals, and mid-century oddities that look like a thrift score.",
            "badge": "♥",
            "accent": "teal"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Barware",
            "body": "Cocktail shakers, tumblers, and pour-ready pieces for a tiki-adjacent shelf.",
            "badge": "!",
            "accent": "yellow"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Uranium glass",
            "body": "The glow-under-blacklight crowd. Bring a light. Leave with something radioactive-cute.",
            "badge": "☢",
            "accent": "lime"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Vintage ads",
            "body": "Paper ephemera and printed nostalgia — framed, stacked, or still in the crate.",
            "badge": "✿",
            "accent": "pink"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Hawaiian shirts",
            "body": "Loud prints, soft cotton, vacation energy with zero itinerary required.",
            "badge": "🌺",
            "accent": "cream"
          }
        }
      ]
    }
  ]
}
{% endschema %}
