<section class="finds" style="padding-top: 0;" aria-label="{{ section.settings.heading | escape }}">
  {% if section.settings.heading != blank %}
    <div class="section-head" style="margin-bottom: 1rem;">
      <h2 class="display-title" style="font-size: clamp(1.8rem, 5vw, 2.6rem);">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="collage">
    {% for block in section.blocks %}
      {% liquid
        assign rotate_class = ''
        if forloop.index0 == 0
          assign rotate_class = 'rotate-left'
        elsif forloop.index0 == 1
          assign rotate_class = 'rotate-right'
        endif
        assign fallback = 'tile-00.png'
        case forloop.index0
          when 1
            assign fallback = 'tile-10.png'
          when 2
            assign fallback = 'tile-01.png'
        endcase
      %}
      <figure class="polaroid {{ rotate_class }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 800
            | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: block.settings.caption
          }}
        {% else %}
          <img
            src="{{ fallback | asset_url }}"
            alt="{{ block.settings.caption | escape }}"
            loading="lazy"
            width="400"
            height="500"
          >
        {% endif %}
        {% if block.settings.caption != blank %}
          <figcaption>{{ block.settings.caption }}</figcaption>
        {% endif %}
      </figure>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collage",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "polaroid",
      "name": "Polaroid",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "booth night"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collage",
      "blocks": [
        { "type": "polaroid", "settings": { "caption": "booth night · 613flea" } },
        { "type": "polaroid", "settings": { "caption": "ticket pile energy" } },
        { "type": "polaroid", "settings": { "caption": "we are HERE" } }
      ]
    }
  ]
}
{% endschema %}
