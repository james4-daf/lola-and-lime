<section id="shop" class="products-section" aria-labelledby="shop-title">
  <div class="section-head">
    {% if section.settings.hand_label != blank %}
      <p class="hand-label">{{ section.settings.hand_label }}</p>
    {% endif %}
    <h2 id="shop-title" class="display-title">{{ section.settings.heading }}</h2>
    {% if section.settings.lede != blank %}
      <p class="lede">{{ section.settings.lede }}</p>
    {% endif %}
  </div>

  {% assign collection = collections[section.settings.collection] %}
  {% if section.settings.collection != blank and collection != blank and collection.products_count > 0 %}
    <ul class="product-grid">
      {% for product in collection.products limit: section.settings.products_to_show %}
        <li>
          {% render 'product-card', product: product %}
        </li>
      {% endfor %}
    </ul>
    {% if section.settings.show_view_all and collection.all_products_count > section.settings.products_to_show %}
      <p style="text-align:center;margin-top:1.5rem;">
        <a class="dymo dymo--outline" href="{{ collection.url }}">View all in {{ collection.title }}</a>
      </p>
    {% endif %}
  {% else %}
    <p class="products-empty">
      {{ section.settings.empty_text }}
    </p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "hand_label",
      "label": "Handwritten label",
      "default": "fresh pulls"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the booth"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "When products are live, they land here. Cards show sold-out badges and swap to a second photo on hover when a gallery exists."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “view all” link",
      "default": true
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty state",
      "default": "No products plugged in yet — pick a collection in the theme editor once inventory is ready."
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
