<section class="cart-page" aria-labelledby="CartTitle">
  <div class="section-head">
    <p class="hand-label">checkout prep</p>
    <h1 id="CartTitle" class="display-title">{{ 'cart.general.title' | t }}</h1>
  </div>

  {% if cart.item_count == 0 %}
    <p class="products-empty">{{ 'cart.general.empty' | t }}</p>
    <p style="text-align:center;margin-top:1rem;">
      <a class="dymo" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
    </p>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      <ul class="product-grid" style="margin-bottom:1.5rem;">
        {% for item in cart.items %}
          <li class="clip clip--cream" style="display:grid;gap:0.5rem;">
            <a href="{{ item.url }}" style="display:block;">
              {% if item.image %}
                {{ item.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: item.product.title }}
              {% endif %}
            </a>
            <h3 style="margin:0;font-family:var(--font-display);">{{ item.product.title }}</h3>
            {% unless item.product.has_only_default_variant %}
              <p style="margin:0;font-size:0.9rem;">{{ item.variant.title }}</p>
            {% endunless %}
            <p style="margin:0;">{{ item.final_line_price | money }}</p>
            <label>
              Qty
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0">
            </label>
            <a href="{{ item.url_to_remove }}">{{ 'cart.general.remove' | t }}</a>
          </li>
        {% endfor %}
      </ul>

      <p style="text-align:center;font-family:var(--font-display);font-size:1.4rem;">
        {{ 'cart.general.subtotal' | t }}: {{ cart.total_price | money }}
      </p>
      <div class="hero__ctas">
        <button type="submit" name="update" class="dymo dymo--outline">{{ 'cart.general.update' | t }}</button>
        <button type="submit" name="checkout" class="dymo">{{ 'cart.general.checkout' | t }}</button>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
