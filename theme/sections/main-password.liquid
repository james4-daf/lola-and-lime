<section class="hero" style="min-height:100vh;">
  <div class="hero__atmosphere" aria-hidden="true">
    <div class="hero__halftone"></div>
    <div class="hero__blob hero__blob--teal"></div>
    <div class="hero__blob hero__blob--lime"></div>
  </div>
  <div class="hero__stage">
    <img
      class="hero__logo wobble"
      src="{{ 'logo-circle.png' | asset_url }}"
      width="180"
      height="180"
      alt="{{ shop.name }}"
    >
    <h1 class="hero__brand" style="font-size:clamp(2.8rem,10vw,5rem);">
      <span class="hero__brand-line">Lola</span>
      <span class="hero__amp">&amp;</span>
      <span class="hero__brand-line">Lime</span>
    </h1>
    <p class="hero__tag">Store opening soon — enter the password if you’ve got it.</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="hero__ctas">
        <input
          type="password"
          name="password"
          placeholder="Password"
          style="font:inherit;border:2.5px solid var(--ink);background:var(--paper);padding:0.7rem 1rem;box-shadow:var(--shadow);"
        >
        <button type="submit" class="dymo">Enter</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
